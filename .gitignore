# Dart / Flutter
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
*.iml
.idea/
.vscode/
coverage/

# Android
android/.gradle/
android/local.properties
android/key.properties
android/app/google-services.json
*.jks
*.keystore

# Firebase secrets: never commit. CI injects google-services.json from a GitHub secret.
google-services.json
GoogleService-Info.plist
firebase_options.dart.local

# Generated by build_runner in CI
lib/**/*.g.dart

# Patch files and their bundles copied into the project folder to apply them.
# They are not part of the app; keeping them out stops "git add -A" from
# committing them (and the analyzer from checking the old copies inside).
/*.patch
/*.zip
/akshaya-fixes/
