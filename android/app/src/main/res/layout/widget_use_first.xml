<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/use_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Use these first"
        android:textColor="@color/widget_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/use_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Nothing is expiring soon."
        android:textColor="@color/widget_text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/use_row_0"
        style="@style/WidgetRow" />

    <TextView
        android:id="@+id/use_row_1"
        style="@style/WidgetRow" />

    <TextView
        android:id="@+id/use_row_2"
        style="@style/WidgetRow" />

    <TextView
        android:id="@+id/use_row_3"
        style="@style/WidgetRow" />

    <TextView
        android:id="@+id/use_row_4"
        style="@style/WidgetRow" />

    <TextView
        android:id="@+id/use_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/widget_text_secondary"
        android:textSize="12sp" />
</LinearLayout>
